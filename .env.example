# Copy to .env, or let `python scripts/demo.py setup` generate .env for you
# (it fills the two secrets with random values). Never commit .env.

# Secrets (generated by setup; leave empty here)
N8N_ENCRYPTION_KEY=
POSTGRES_PASSWORD=

# n8n image tag (pinned)
N8N_VERSION=2.47.5

# Host ports, all bound to 127.0.0.1 only
N8N_PORT=5678
POSTGRES_PORT=5433
MOCK_LLM_PORT=8000

# Postgres (the "existing persistent store")
POSTGRES_DB=dedupe
POSTGRES_USER=dedupe

# Mock LLM: latency per call in seconds, and optional comma-separated event ids
# whose FIRST call should fail with HTTP 500 (fault injection)
MOCK_LATENCY_S=1.5
MOCK_FAIL_FIRST=

# The "AI call". Default is the local mock (free, no key). To use a real
# OpenAI-compatible endpoint (OpenAI, or Ollama at http://host.docker.internal:11434/v1),
# set these. Untested with a real provider in this repo.
OPENAI_BASE_URL=http://mock-llm:8000/v1
OPENAI_API_KEY=mock-key-not-secret
OPENAI_MODEL=gpt-4o-mini
