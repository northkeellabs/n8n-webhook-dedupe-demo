{
  "id": "dedupeNaive00001",
  "name": "Dedupe demo 1 - naive (read-then-write check)",
  "active": false,
  "settings": { "executionOrder": "v1" },
  "nodes": [
    {
      "id": "0b1f3c3e-3a6c-4c2f-9a01-000000000101",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.2,
      "position": [0, 0],
      "webhookId": "0b1f3c3e-3a6c-4c2f-9a01-0000000001a1",
      "parameters": {
        "httpMethod": "POST",
        "path": "dedupe-naive",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "0b1f3c3e-3a6c-4c2f-9a01-000000000102",
      "name": "Already seen?",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [240, 0],
      "notes": "Read step of a read-then-write check. Concurrent deliveries all read 'not seen' before any of them writes.",
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS seen FROM processed_events WHERE event_key = $1;",
        "options": {
          "queryReplacement": "={{ $json.headers['x-event-id'] ?? '' }}"
        }
      },
      "credentials": { "postgres": { "id": "dedupeDemoPg0001", "name": "Dedupe demo Postgres" } }
    },
    {
      "id": "0b1f3c3e-3a6c-4c2f-9a01-000000000103",
      "name": "Not seen?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            {
              "id": "6f0c2b8e-0000-4000-8000-000000000101",
              "leftValue": "={{ $json.seen }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "equals" }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "0b1f3c3e-3a6c-4c2f-9a01-000000000104",
      "name": "LLM call",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, -100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.OPENAI_BASE_URL }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.OPENAI_API_KEY }}" },
            { "name": "X-Event-Id", "value": "={{ $('Webhook').item.json.headers['x-event-id'] }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.OPENAI_MODEL, messages: [{ role: 'user', content: 'Summarise this fictional webhook event in one line: ' + JSON.stringify($('Webhook').item.json.body) }] }) }}",
        "options": { "timeout": 30000 }
      }
    },
    {
      "id": "0b1f3c3e-3a6c-4c2f-9a01-000000000105",
      "name": "Insert record",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [960, -100],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO records (workflow, event_key, payload, llm_summary)\nVALUES ('naive', $1, $2::jsonb, $3)\nRETURNING id, event_key;",
        "options": {
          "queryReplacement": "={{ $('Webhook').item.json.headers['x-event-id'] }},{{ JSON.stringify($('Webhook').item.json.body ?? {}) }},{{ $json.choices[0].message.content }}"
        }
      },
      "credentials": { "postgres": { "id": "dedupeDemoPg0001", "name": "Dedupe demo Postgres" } }
    },
    {
      "id": "0b1f3c3e-3a6c-4c2f-9a01-000000000106",
      "name": "Mark seen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [1200, -100],
      "notes": "Write step of the read-then-write check, done only after the slow LLM call: the race window is the whole run.",
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO processed_events (event_key, status) VALUES ($1, 'done')\nON CONFLICT (event_key) DO UPDATE SET status = 'done', updated_at = now()\nRETURNING event_key, status;",
        "options": {
          "queryReplacement": "={{ $('Webhook').item.json.headers['x-event-id'] }}"
        }
      },
      "credentials": { "postgres": { "id": "dedupeDemoPg0001", "name": "Dedupe demo Postgres" } }
    },
    {
      "id": "0b1f3c3e-3a6c-4c2f-9a01-000000000107",
      "name": "Already processed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [720, 120],
      "parameters": {}
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Already seen?", "type": "main", "index": 0 }]] },
    "Already seen?": { "main": [[{ "node": "Not seen?", "type": "main", "index": 0 }]] },
    "Not seen?": {
      "main": [
        [{ "node": "LLM call", "type": "main", "index": 0 }],
        [{ "node": "Already processed", "type": "main", "index": 0 }]
      ]
    },
    "LLM call": { "main": [[{ "node": "Insert record", "type": "main", "index": 0 }]] },
    "Insert record": { "main": [[{ "node": "Mark seen", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": true }
}
